{
  "name": "zoneit-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "deploy": "wrangler deploy --config ../wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "d1:migrate:local": "wrangler d1 migrations apply zoneit --local --config ../wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply zoneit --remote --config ../wrangler.jsonc"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.12.25",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.13",
    "prisma": "^5.22.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.82.2"
  }
}
